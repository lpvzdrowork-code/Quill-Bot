{
  "name": "quill_discordbot",
  "version": "1.0.0",
  "description": "A professional moderation and logging bot.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy.ts",
    "deploy:clear-guild": "tsx src/clearGuildCommands.ts",
    "dev:fresh": "npx prisma generate && npm run deploy && npm run dev",
    "up": "npx prisma generate && npm run typecheck && npm test && npm run deploy && pm2 startOrRestart ecosystem.config.cjs --update-env",
    "down": "pm2 stop Quill-Bot",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
