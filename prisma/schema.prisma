// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Guild ────────────────────────────────────────────────────────────────────
// Tracks every guild Quill is currently installed in. One row per guild,
// created on guildCreate, name refreshed on guildUpdate. `suspended` is
// checked before any moderation command executes (see interactionCreate.ts)
// and is toggled exclusively from the admin dashboard — never by the bot.

model Guild {
  id              String    @id // Discord guild ID — natural key, not a cuid
  name            String?
  joinedAt        DateTime  @default(now())
  suspended       Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?
}

// ─── Warn ─────────────────────────────────────────────────────────────────────
// Stores moderation warnings issued to users.

model Warn {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  @@index([guildId, userId])
}

// ─── Timeout ──────────────────────────────────────────────────────────────────
// Stores timeout history for users.
// endedAt is set when a timeout is manually removed via /untimeout.
// If endedAt is null and expiresAt is in the future, the timeout is still active.

model Timeout {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  duration    Int       // Duration in seconds
  expiresAt   DateTime
  endedAt     DateTime? // Set when manually removed via /untimeout; null = still active or expired naturally
  createdAt   DateTime  @default(now())

  @@index([guildId, userId])
}

// ─── Ban ──────────────────────────────────────────────────────────────────────
// Stores ban history for users.
// endedAt is set when the ban is lifted via /unban; null = still active.
// Softbans set endedAt immediately since the unban is automatic.

model Ban {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  deleteDays  Int       @default(0) // Number of days of messages deleted (0-7)
  endedAt     DateTime?             // Set when lifted via /unban; null = still active
  createdAt   DateTime  @default(now())

  @@index([guildId, userId])
}

// ─── Kick ─────────────────────────────────────────────────────────────────────
// Stores kick history for users.

model Kick {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  @@index([guildId, userId])
}

// ─── Blacklist ────────────────────────────────────────────────────────────────
// Stores blacklist entries for users.
// active = true means the blacklist is currently in effect.
// When a user is unblacklisted, active is set to false and revokedAt is set.
// Keeping the row (rather than deleting it) preserves audit history for /modlogs.

model Blacklist {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  active      Boolean   @default(true)
  revokedAt   DateTime?              // Set when the blacklist is lifted via /unblacklist
  revokedById String?                // Moderator who removed the blacklist
  createdAt   DateTime  @default(now())

  @@index([guildId, userId])
  @@index([guildId, userId, active])
  // NOTE: a partial unique index (one active Blacklist per guildId+userId) is
  // enforced via raw SQL in migration 20260629230000_add_active_unique_constraints,
  // since Prisma's schema syntax cannot express a partial/filtered unique index.
}

// ─── Flag ─────────────────────────────────────────────────────────────────────
// Stores flag entries for users under staff watch.
// active = true means the flag is currently in effect.
// When a user is unflagged, active is set to false and revokedAt is set.
// Keeping the row preserves audit history for /modlogs.

model Flag {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  active      Boolean   @default(true)
  revokedAt   DateTime?              // Set when the flag is lifted via /unflag
  revokedById String?                // Moderator who removed the flag
  createdAt   DateTime  @default(now())

  @@index([guildId, userId])
  @@index([guildId, userId, active])
  // NOTE: a partial unique index (one active Flag per guildId+userId) is
  // enforced via raw SQL in migration 20260629230000_add_active_unique_constraints,
  // since Prisma's schema syntax cannot express a partial/filtered unique index.
}

// ─── LogChannel ────────────────────────────────────────────────
// Maps a log category (e.g. "mod-logs", "member-logs", "bot-logs") to a
// destination channel for a guild. Replaces the old hardcoded
// STAFF_LOG_CHANNEL / MEMBER_LOG_CHANNEL / BOT_LOG_CHANNEL env vars —
// configured at runtime via /setup logging instead of requiring a redeploy.
// `enabled` lets /setup toggle a category off without losing its channel
// mapping, so re-enabling it doesn't require re-entering the channel.

model LogChannel {
  id        String   @id @default(cuid())
  guildId   String
  category  String   // One of LOG_CATEGORIES in src/utils/guildConfig.ts
  channelId String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, category])
  @@index([guildId])
}

// ─── CommandChannel ──────────────────────────────────────────────
// Whitelists channels where Quill's commands may be used, configured via
// /setup command-channel. If no rows exist for a guild, commands are allowed
// in any channel (unrestricted) — the restriction only takes effect once at
// least one channel has been explicitly designated.

model CommandChannel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  createdAt DateTime @default(now())

  @@unique([guildId, channelId])
  @@index([guildId])
}

// ─── GuildRole ────────────────────────────────────────────────
// Maps a functional role slot ("timeout", "blacklist", "flag") to an actual
// role ID for a guild. Replaces the old hardcoded TIMEOUT_ROLE / BLACKLIST_ROLE
// / FLAG_ROLE env vars, which were a single set of role IDs shared across every
// server Quill was in — meaning /blacklist, /timeout, and /flag could only
// ever work correctly in the one guild those IDs actually belonged to.
// Configured at runtime via /setup role instead of requiring a redeploy.

model GuildRole {
  id        String   @id @default(cuid())
  guildId   String
  roleType  String   // One of ROLE_TYPES in src/utils/guildConfig.ts
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, roleType])
  @@index([guildId])
}

// ─── SecuritySettings ─────────────────────────────────────────────────────────
// Per-guild anti-raid / anti-nuke thresholds and response actions, configured
// via /setup security. One row per guild, created lazily on the first write —
// a missing row means "use the defaults baked into securityConfig.ts".

model SecuritySettings {
  guildId             String   @id
  antiRaidEnabled     Boolean  @default(true)
  raidJoinThreshold   Int      @default(10) // joins...
  raidWindowSeconds   Int      @default(10) // ...within this many seconds trips the raid response
  raidAction          String   @default("lockdown") // "alert" | "lockdown" | "kick_new"
  lockdownMinutes     Int      @default(10) // how long a triggered lockdown holds before auto-reverting
  antiNukeEnabled     Boolean  @default(true)
  nukeActionThreshold Int      @default(5) // destructive audit-log actions by one user...
  nukeWindowSeconds   Int      @default(60) // ...within this many seconds trips the nuke response
  nukeAction          String   @default("strip_roles") // "alert" | "strip_roles" | "ban"
  trustedRoleId       String?  // members with this role are exempt from anti-nuke punishment
  updatedAt           DateTime @updatedAt
}

// ─── SecurityIncident ─────────────────────────────────────────────────────────
// Audit trail of every raid/nuke detection and the automatic response Quill
// took. Kept independent of the LOG_CATEGORIES routing in LogChannel — this
// is the historical record even for a guild that never configured staff-logs.

model SecurityIncident {
  id        String   @id @default(cuid())
  guildId   String
  type      String   // "raid" | "nuke"
  actorId   String?  // responsible user, when known (nuke: the executor)
  action    String   // response Quill took, e.g. "lockdown", "strip_roles", "alert"
  details   String
  createdAt DateTime @default(now())

  @@index([guildId, type])
}